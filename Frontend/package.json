{
  "name": "codexia-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write --ignore-path ../.prettierignore \"**/*.{js,jsx,css,html}\" \"../Backend/**/*.{js,cjs,mjs}\" \"../README.md\"",
    "format:check": "prettier --check --ignore-path ../.prettierignore \"**/*.{js,jsx,css,html}\" \"../Backend/**/*.{js,cjs,mjs}\" \"../README.md\""
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^7.1.7"
  }
}
